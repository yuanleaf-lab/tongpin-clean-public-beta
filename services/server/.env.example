PORT=3000
DATA_FILE=./data/rooms.json

# Optional. If empty, /api/rooms/:code/chat uses mock development replies.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# OpenAI-compatible API base URL. Examples:
# https://api.openai.com/v1
# https://your-proxy.example.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Default is chat_completions for broad proxy compatibility.
# Use responses only for providers that support /v1/responses.
AI_ENDPOINT_MODE=chat_completions
